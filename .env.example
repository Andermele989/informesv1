# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env)
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas el `.env` real a Git (ya está en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de datos PostgreSQL
# ------------------------------------------------------------------------------
# En un servidor (Render, Railway, Supabase…) basta con una sola variable:
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# En local:
DB_USER=postgres
DB_PASS=tu_contraseña_segura
DB_HOST=localhost
DB_PORT=5432
DB_NAME=informes_db

# ------------------------------------------------------------------------------
# 2. Seguridad
# ------------------------------------------------------------------------------
# Clave aleatoria larga que firma las cookies de sesión. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si falta, se usa una clave temporal y las sesiones se pierden al reiniciar.
SECRET_KEY=genera_una_clave_secreta_aleatoria_larga_aqui

# Días que dura una sesión guardada en el navegador (por defecto 7).
# SESSION_TTL_DAYS=7

# Contraseña de la cuenta "admin" en el primer arranque. Si no la defines, se genera una
# aleatoria y se muestra UNA vez en la consola del servidor.
# ADMIN_INITIAL_PASSWORD=elige_una_contraseña_larga

# ------------------------------------------------------------------------------
# 3. Inteligencia artificial (opcional: análisis y PDF del dashboard)
# ------------------------------------------------------------------------------
# Claves en https://aistudio.google.com/app/apikey y https://platform.openai.com/api-keys
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
